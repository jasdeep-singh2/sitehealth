{
  "Crawler": {
    "MaxConcurrency": 5,
    "MaxLinksPerPage": 500,
    "TimeoutSeconds": 15,
    "UserAgent": "SiteHealthBot/0.1 (+https://github.com/jasdeep-singh2/sitehealth)",
    "AllowPrivateNetworks": false
  },
  "Ai": {
    "Model": "claude-sonnet-5-5",
    "Effort": "low",
    "MaxGroupsPerRequest": 50,
    "MaxTokens": 16000
  },
  "ConnectionStrings": {
    "SiteHealth": "Server=(localdb)\\MSSQLLocalDB;Database=SiteHealth;Trusted_Connection=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimit": {
    "ScansPerMinute": 10,
    "ReadsPerMinute": 120
  },
  "ScanQueue": {
    "Capacity": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
