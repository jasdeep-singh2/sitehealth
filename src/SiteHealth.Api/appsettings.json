{
  "Crawler": {
    "MaxConcurrency": 5,
    "TimeoutSeconds": 15,
    "UserAgent": "SiteHealthBot/0.1 (+https://github.com/jasdeep-singh2/sitehealth)"
  },
  "Ai": {
    "Model": "claude-sonnet-5-5",
    "Effort": "low",
    "MaxGroupsPerRequest": 50,
    "MaxTokens": 16000
  },
  "ScanQueue": {
    "Capacity": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
